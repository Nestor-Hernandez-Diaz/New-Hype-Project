    {
      "name": "00 - AUTENTICACIÓN",
      "item": [

        {
          "name": "01 - Register (Obtener Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('token', res.data.accessToken);",
                  "    console.log('✅ Token guardado:', res.data.accessToken.substring(0,30) + '...');",
                  "} else {",
                  "    console.error('❌ No se encontró accessToken en la respuesta');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Demo\",\n  \"apellido\": \"Presentacion\",\n  \"email\": \"demo.flujo2026@newhype.com\",\n  \"password\": \"Demo2026!\",\n  \"nombreTienda\": \"NewHype Tienda Demo\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api","v1","auth","register"] }
          }
        },

        {
          "name": "02 - Check Email (Verificar si existe)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/check-email?email=demo.flujo2026@newhype.com",
              "host": ["{{base_url}}"],
              "path": ["api","v1","auth","check-email"],
              "query": [{ "key": "email", "value": "demo.flujo2026@newhype.com" }]
            }
          }
        }

      ]
    },

